{
    "name": "anovsiradj/tttaiga",
    "description": "TTTaiga",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "anovsiradj",
            "email": "anov.siradj22@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../php-skit",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../web-skit",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "app\\": "app/"
        }
    },
    "require": {
        "php": ">=8.1",
        "anovsiradj/skit": "@dev",
        "anovsiradj/web-skit": "@dev",
        "symfony/var-dumper": "^5.4",
        "yiisoft/arrays": "@dev"
    }
}