{
    "name": "anovsiradj/tttaiga",
    "description": "TTTaiga",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "anovsiradj",
            "email": "anov.siradj22@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../wiet",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../php-skit",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../web-skit",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "app\\": "app/"
        }
    },
    "require": {
        "php": ">=8.4",
        "anovsiradj/wiet": "@dev",
        "anovsiradj/php-skit": "@dev",
        "anovsiradj/web-skit": "@dev",
        "symfony/var-dumper": "@stable",
        "yiisoft/arrays": "@dev",
        "yiisoft/strings": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2"
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "test:unit": "phpunit --testsuite unit --colors=always",
        "test:integration": "phpunit --testsuite integration --colors=always"
    }
}
